{
    "name": "hampel/slack-message",
    "description": "Standalone implementation of Laravel's SlackMessage classes from illuminate/notifications",
    "keywords": [
        "slack",
        "laravel",
        "notifications"
    ],
    "homepage": "https://github.com/hampel/slack-message",
    "license": "MIT",
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com"
        }
    ],
    "support": {
        "issues": "https://github.com/hampel/slack-message/issues",
        "source": "https://github.com/hampel/slack-message"
    },
    "require": {
        "php": "^8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "hampel/rig": "^0.1.0",
        "laravel/pint": "^1.30",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Sends the message. Any PSR-18 client will do; Guzzle (^7.0) also provides the PSR-17 factories, which are then discovered automatically"
    },
    "autoload": {
        "psr-4": {
            "Hampel\\SlackMessage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hampel\\SlackMessage\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
