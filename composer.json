{
    "name": "hampel/slack-message",
    "description": "Standalone implementation of Laravel's SlackMessage classes from illuminate/notifications",
    "keywords": [
        "slack",
        "laravel",
        "notifications"
    ],
    "homepage": "https://github.com/hampel/slack-message",
    "license": "MIT",
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com"
        }
    ],
    "support": {
        "issues": "https://github.com/hampel/slack-message/issues",
        "source": "https://github.com/hampel/slack-message"
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "laravel/slack-notification-channel": "^3.0",
        "mockery/mockery": "^1.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Required to use the Slack transport (^7.0)"
    },
    "autoload": {
        "psr-4": {
            "Hampel\\SlackMessage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hampel\\SlackMessage\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check": [
            "@analyse",
            "@test"
        ]
    }
}
