# Copy this to .env, which is gitignored, and fill in what the exercise you want needs.
# docs/slack-setup.md walks through obtaining each of these.

# An incoming webhook URL, bound to one channel.
# Used by: rig send, rig queued, rig legacy
SLACK_WEBHOOK_URL=

# A bot token, with the chat:write, chat:write.public and chat:write.customize scopes.
# Used by: rig api
SLACK_BOT_TOKEN=

# Where rig api posts. A channel name (#general) or an ID (C01234567); the ID survives
# the channel being renamed.
# Used by: rig api
SLACK_CHANNEL=
