# Copy this to .env, which is gitignored, and fill in what the exercise you want needs.
# The README walks through obtaining each of these, under Setting up Slack credentials.

# Nothing is posted to Slack unless this is exactly 1. Without it the sending exercises
# run against a sink that records the request and shows it to you, which answers a
# different question - see The harness in CLAUDE.md.
#
# There is a second switch, SLACK_AGENT_MAY_DELIVER, which an agent needs as well. It is
# deliberately not listed below: it belongs on the one command line that wants it, never
# in this file.
SLACK_DELIVER=

# An incoming webhook URL, bound to one channel.
# Used by: rig send, rig queued, rig legacy
SLACK_WEBHOOK_URL=

# A bot token. Sending needs chat:write, chat:write.public and chat:write.customize;
# listing channels also needs channels:read and groups:read.
# Used by: rig api, rig channels
SLACK_BOT_TOKEN=

# Where rig api posts. A channel name (#general) or an ID (C01234567); the ID survives
# the channel being renamed.
# Used by: rig api
SLACK_CHANNEL=
